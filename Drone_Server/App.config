<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>

	<!--pregledati pre nastavka rada!!-->
	
	<appSettings>
		<add key="A_threshold" value=""/> <!--ne vidim da specifikacija navodi tacnu vrednost za pragove-->
		<add key="W_threshold" value=""/>
		<add key="Deviation" value="0.25"/>
	</appSettings>

	<system.serviceModel>
		<services>
			<service name="Drone_Server.DroneService">
				
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4002"/>
					</baseAddresses>
				</host>

				<endpoint
				  address="DroneService"
				  binding="netTcpBinding"
				  bindingConfiguration="DroneTcp"
				  contract="Common.IDroneService"/>

			</service>
		</services>

		<bindings>
			<netTcpBinding>
				<binding name="DroneTcp"
						 transferMode="Streamed"
						 maxReceivedMessageSize="100">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>

	</system.serviceModel>
</configuration>