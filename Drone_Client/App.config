<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>

	<appSettings>
		<add key="flightDirectory" value="flights"/>
		<add key="logDirectory" value="logs/log.txt"/>
		<add key="rowRead" value="100"/>
		<add key="meta"
         value="LinearAccelerationX,LinearAccelerationY,LinearAccelerationZ,WindSpeed,WindAngle,Time"/>
	</appSettings>
	
	<system.serviceModel>
		<client>
			
			<endpoint name="DroneService"
					  address="net.tcp://localhost:4002/DroneService"
					  binding="netTcpBinding"
					  bindingConfiguration="DroneTcp"
					  contract="Common.IDroneService"/>
		</client>

		<bindings>
			<netTcpBinding>
				<binding name="DroneTcp"
						 transferMode="Streamed"
						 maxBufferSize="65536"
						 maxReceivedMessageSize="10485760">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>

	</system.serviceModel>
</configuration>