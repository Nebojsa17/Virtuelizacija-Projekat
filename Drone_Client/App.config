<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>

	<system.serviceModel>
		<client>
			
			<endpoint name="DroneService"
					  address="net.tcp://localhost:4002"
					  binding="netTcpBinding"
					  bindingConfiguration="DroneTcp"
					  contract="DroneCommon.Contracts.IDroneService"/>
		</client>

		<bindings>
			<netTcpBinding>
				<binding name="DroneTcp"
						 transferMode="Streamed"
						 maxReceivedMessageSize="100">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>

	</system.serviceModel>
</configuration>